{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "llmfn-phones",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_als"],
  "workers_dev": true,
  "preview_urls": true,
  "send_email": [{ "name": "EMAIL" }],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  }
}
