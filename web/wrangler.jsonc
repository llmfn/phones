{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "llmfn-phones",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_als"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "phones.llmfn.com/*", "zone_name": "llmfn.com" },
    { "pattern": "*-phones.llmfn.com/*", "zone_name": "llmfn.com" }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "llmfn-phones",
      "database_id": "d0b1adf8-51ae-40de-9588-003ce1c474c3"
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  }
}
